DERIV_API_TOKEN=
DERIV_APP_ID=1089

# MetaApi.cloud bridge to your Deriv MT5 account - live quotes, positions,
# account state and candles for Kora (scripts/run_kora.py).
METAAPI_TOKEN=
METAAPI_ACCOUNT_ID=

# Ask Kora chat + optional "Kora's take" narratives (Settings page toggle).
ANTHROPIC_API_KEY=
# KORA_MODEL=claude-opus-5-5

# Push alerts (any or both). Telegram: create a bot with @BotFather, then get
# your chat id by messaging the bot and visiting
# https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Discord/Slack-style incoming webhook URL (optional)
KORA_WEBHOOK_URL=
# If the dashboard is reachable remotely (e.g. ngrok), alerts link to the breakdown page
DASHBOARD_PUBLIC_URL=

# Set to "sim" to run Kora + the hub on simulated data (demo / development).
KORA_DATA_SOURCE=

# Only needed if exposing the dashboard beyond 127.0.0.1 (e.g. via a tunnel).
# Leave blank for pure-localhost use.
DASHBOARD_PASSWORD=

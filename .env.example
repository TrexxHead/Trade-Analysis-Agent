DERIV_API_TOKEN=
DERIV_APP_ID=1089

# OPTIONAL, paid: MetaApi.cloud bridge to MT5. Not needed if the MT5 terminal
# runs on this PC - Kora reads it directly for free (see KORA_DATA_SOURCE).
METAAPI_TOKEN=
METAAPI_ACCOUNT_ID=

# Ask Kora chat + optional "Kora's take" narratives (Settings page toggle).
ANTHROPIC_API_KEY=
# KORA_MODEL=claude-opus-5-5

# Push alerts (any or both). Telegram: create a bot with @BotFather, then get
# your chat id by messaging the bot and visiting
# https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Discord/Slack-style incoming webhook URL (optional)
KORA_WEBHOOK_URL=
# If the dashboard is reachable remotely (e.g. ngrok), alerts link to the breakdown page
DASHBOARD_PUBLIC_URL=

# Where live data comes from: auto (default) | mt5 | deriv | metaapi | sim
#   auto  = your MT5 terminal if it's open (free), else MetaApi if configured, else Deriv's free feed
#   mt5   = the Deriv MT5 app on this PC via the free MetaTrader5 package (Windows)
#   deriv = Deriv's free public API: prices + candles only, no positions/balance
#   sim   = simulated data for demos
KORA_DATA_SOURCE=

# Only if Kora can't find your MT5 terminal on its own, or you want it to log in for you:
MT5_PATH=
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=

# Only needed if exposing the dashboard beyond 127.0.0.1 (e.g. via a tunnel).
# Leave blank for pure-localhost use.
DASHBOARD_PASSWORD=
